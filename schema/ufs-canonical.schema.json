{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Scimonesays/Universal-Frequency-Spectrum/schema/ufs-canonical.schema.json",
  "title": "Universal Frequency Spectrum canonical dataset schema",
  "description": "Schema for UFS canonical JSON datasets. External validations additionally conform to ufs-validation-result.schema.json.",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/phenomenaDataset"
    },
    {
      "$ref": "#/$defs/interactionsDataset"
    },
    {
      "$ref": "#/$defs/frontierDataset"
    },
    {
      "$ref": "#/$defs/entitiesDataset"
    },
    {
      "$ref": "#/$defs/rangesDataset"
    },
    {
      "$ref": "#/$defs/sourcesDataset"
    },
    {
      "$ref": "#/$defs/claimsDataset"
    },
    {
      "$ref": "#/$defs/gapsDataset"
    },
    {
      "$ref": "#/$defs/energyRolesDataset"
    },
    {
      "$ref": "ufs-validation-result.schema.json"
    }
  ],
  "$defs": {
    "datasetHeader": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_type",
        "records"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "dataset_type": {
          "type": "string"
        },
        "records": {
          "type": "array"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "class",
        "label"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "established",
            "observed",
            "model-dependent",
            "open",
            "speculative",
            "contested",
            "theoretical",
            "unverified",
            "not-established",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "spectral": {
      "type": "object",
      "properties": {
        "min_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "characteristic_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "range_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "periodic_or_rotational",
            "propagating_wave",
            "normal_mode_or_resonance",
            "transition_frequency",
            "detector_band",
            "characteristic_inverse_timescale",
            "characteristic_rate",
            "energy_equivalent_frequency",
            "classification_band",
            "biological_sensitivity",
            "parameter_dependent",
            "state_dependent",
            "other",
            null
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "energyAccounting": {
      "type": "object",
      "properties": {
        "system_boundary": {
          "type": [
            "string",
            "null"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "STORES",
              "CARRIES",
              "RECEIVES",
              "SUPPLIES",
              "TRANSFERS",
              "CONVERTS",
              "ABSORBS",
              "EMITS",
              "DOES_WORK",
              "DISSIPATES",
              "THERMALIZES",
              "DISPERSES",
              "MAINTAINS_STEADY_STATE",
              "EXCHANGES",
              "MEDIATES",
              "READS_OUT",
              "UNKNOWN"
            ]
          },
          "uniqueItems": true
        },
        "source_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "STORES",
              "CARRIES",
              "RECEIVES",
              "SUPPLIES",
              "TRANSFERS",
              "CONVERTS",
              "ABSORBS",
              "EMITS",
              "DOES_WORK",
              "DISSIPATES",
              "THERMALIZES",
              "DISPERSES",
              "MAINTAINS_STEADY_STATE",
              "EXCHANGES",
              "MEDIATES",
              "READS_OUT",
              "UNKNOWN"
            ]
          },
          "uniqueItems": true
        },
        "target_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "STORES",
              "CARRIES",
              "RECEIVES",
              "SUPPLIES",
              "TRANSFERS",
              "CONVERTS",
              "ABSORBS",
              "EMITS",
              "DOES_WORK",
              "DISSIPATES",
              "THERMALIZES",
              "DISPERSES",
              "MAINTAINS_STEADY_STATE",
              "EXCHANGES",
              "MEDIATES",
              "READS_OUT",
              "UNKNOWN"
            ]
          },
          "uniqueItems": true
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "balance_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "fate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "phase",
        "source_file"
      ],
      "properties": {
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "phenomenon": {
      "type": "object",
      "required": [
        "id",
        "claim_id",
        "record_type",
        "name",
        "family",
        "spectral",
        "evidence",
        "source_ids",
        "energy_accounting",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "const": "phenomenon"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "spectral": {
          "$ref": "#/$defs/spectral"
        },
        "physical": {
          "type": "object"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "energy_accounting": {
          "$ref": "#/$defs/energyAccounting"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": [
        "id",
        "claim_id",
        "record_type",
        "source",
        "target",
        "source_entity_id",
        "target_entity_id",
        "interaction_type",
        "evidence",
        "source_ids",
        "energy_accounting",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P3-E\\d{3}$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "const": "interaction"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "target_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "interaction_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "energy_accounting": {
          "$ref": "#/$defs/energyAccounting"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "frontier": {
      "type": "object",
      "required": [
        "id",
        "claim_id",
        "record_type",
        "domain",
        "name",
        "status",
        "evidence",
        "source_ids",
        "energy_accounting",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P4-[A-Z]\\d{3}$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "const": "frontier"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "energy_accounting": {
          "$ref": "#/$defs/energyAccounting"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "family",
        "related_phenomenon_ids",
        "role",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "related_phenomenon_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": [
        "id",
        "phenomenon_id",
        "min_hz",
        "max_hz",
        "characteristic_hz",
        "range_kind",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RANGE-"
        },
        "phenomenon_id": {
          "type": "string",
          "minLength": 1
        },
        "min_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "characteristic_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "range_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "title",
        "urls",
        "source_note_file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[234567]-SRC-\\d{3}$"
        },
        "phase": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "source_note_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "claim",
        "status",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLAIM-"
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "record_id": {
          "type": "string"
        },
        "legacy_id": {
          "type": "string"
        },
        "evidence_note": {
          "type": "string"
        },
        "provenance_file": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "gap": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "status",
        "scope",
        "related_ids",
        "source_ids",
        "meaning"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GAP-[A-Z]+-\\d{3}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "instrument_gap",
            "theory_gap",
            "catalog_gap",
            "constraint_gap",
            "true_forbidden_region",
            "visual_gap_only",
            "energy_accounting_gap",
            "mechanism_gap",
            "replication_gap",
            "operationalization_gap"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "related_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "energyRole": {
      "type": "object",
      "required": [
        "code",
        "label",
        "meaning",
        "does_not_mean",
        "example"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "STORES",
            "CARRIES",
            "RECEIVES",
            "SUPPLIES",
            "TRANSFERS",
            "CONVERTS",
            "ABSORBS",
            "EMITS",
            "DOES_WORK",
            "DISSIPATES",
            "THERMALIZES",
            "DISPERSES",
            "MAINTAINS_STEADY_STATE",
            "EXCHANGES",
            "MEDIATES",
            "READS_OUT",
            "UNKNOWN"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "does_not_mean": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "energyRule": {
      "type": "object",
      "required": [
        "code",
        "label",
        "meaning",
        "does_not_mean",
        "example"
      ],
      "properties": {
        "code": {
          "const": "NO_CREATE_FROM_NOTHING"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "does_not_mean": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "phenomenaDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "phenomena"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/phenomenon"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "interactionsDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "interactions"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/interaction"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "frontierDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "frontier"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/frontier"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "entitiesDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "entities"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/entity"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rangesDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "ranges"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/range"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sourcesDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "sources"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "claimsDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "claims"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gapsDataset": {
      "allOf": [
        {
          "$ref": "#/$defs/datasetHeader"
        },
        {
          "properties": {
            "dataset_type": {
              "const": "gaps"
            },
            "records": {
              "items": {
                "$ref": "#/$defs/gap"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "energyRolesDataset": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_type",
        "records",
        "rules"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "dataset_type": {
          "const": "energy_roles"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/energyRole"
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/energyRule"
          }
        }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "project",
        "schema_version",
        "dataset_type",
        "status",
        "counts",
        "files",
        "legacy_inputs",
        "audit",
        "integrations"
      ],
      "properties": {
        "project": {
          "const": "Universal Frequency Spectrum"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "dataset_type": {
          "const": "manifest"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacy_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit": {
          "type": "object"
        },
        "integrations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
